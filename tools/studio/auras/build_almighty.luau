		Vector3.new(7.2, 0.05, 7.2),
		CFrame.new(0, FEET + 0.06, 0),
		Vector3.new(0, 0.04, 0)
	)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "PoolGui"
	gui.Face = Enum.NormalId.Top
	gui.LightInfluence = 0
	gui.Brightness = 1
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 70
	gui.Parent = plate
	local function layer(name, image, colour, transparency, scale, z)
		local l = Instance.new("ImageLabel")
		l.Name = name
		l.BackgroundTransparency = 1
		l.AnchorPoint = Vector2.new(0.5, 0.5)
		l.Position = UDim2.fromScale(0.5, 0.5)
		l.Size = UDim2.fromScale(scale, scale)
		l.Image = image
		l.ImageColor3 = colour
		l.ImageTransparency = transparency
		l.ZIndex = z
		l.Parent = gui
	end
	-- a faint cold glow under the pool so its edge reads on a dark floor too
