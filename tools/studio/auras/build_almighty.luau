	layer("Shadow", TEX.pool, rgb(255, 255, 255), 0, 1, 2)
	local disc =
		carrier(rootG, "PoolEyes", Vector3.new(6, 0.2, 6), CFrame.new(0, FEET + 0.12, 0), nil)
