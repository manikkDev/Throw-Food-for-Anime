local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end
local function NS(points)
	local kps = {}
	for _, p in points do
		table.insert(kps, NumberSequenceKeypoint.new(p[1], p[2], p[3] or 0))
	end
	return NumberSequence.new(kps)
end
local function CS(points)
	local kps = {}
	for _, p in points do
		table.insert(kps, ColorSequenceKeypoint.new(p[1], p[2]))
	end
	return ColorSequence.new(kps)
end

local live = 0
local function emitter(parent: Instance, name: string, props: { [string]: any })
	local e = Instance.new("ParticleEmitter")
	e.Name = name
	e.LightInfluence = 0
	e.LockedToPart = false
	for k, v in props do
		(e :: any)[k] = v
	end
	live += e.Rate * (e.Lifetime.Min + e.Lifetime.Max) / 2
	e.Parent = parent
	return e
end

local function att(parent: Instance, name: string, cf: CFrame, rootSpace: boolean)
	local a = Instance.new("Attachment")
	a.Name = name
	a.CFrame = cf
	if rootSpace then
		a:SetAttribute("RS", true)
	end
	a.Parent = parent
	return a
end

local function carrier(
	parent: Instance,
	name: string,
	size: Vector3,
	rootCf: CFrame,
	spin: Vector3?
)
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.Transparency = 1
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.CastShadow = false
	p.CFrame = rootCf
	p:SetAttribute("RootCF", rootCf)
	if spin then
		p:SetAttribute("Spin", spin)
	end
	p.Parent = parent
	return p
end

local folder = Instance.new("Folder")
folder.Name = KEY
local function group(name: string): Instance
	local g = folder:FindFirstChild(name)
	if not g then
		g = Instance.new("Folder")
		g.Name = name
		g.Parent = folder
	end
	return g
end
local function direct(partName: string): Instance
	local g = group(partName)
	local d = g:FindFirstChild("Direct")
	if not d then
		d = Instance.new("Folder")
		d.Name = "Direct"
		d.Parent = g
	end
	return d
end

-- the two kinds of particle most of it is made of: a patch of ink, an eye in its ink (both pre-coloured)
local function ink(parent: Instance, name: string, rate: number, size: number, z: number)
	return emitter(parent, name, {
		Texture = TEX.ink,
		FlipbookLayout = Enum.ParticleFlipbookLayout.Grid4x4,
		FlipbookMode = Enum.ParticleFlipbookMode.OneShot,
		Rate = rate,
		Lifetime = NumberRange.new(1.6, 2.2),
		Speed = NumberRange.new(0, 0),
		Size = NS({ { 0, size, size * 0.15 }, { 1, size * 1.08, size * 0.15 } }),
		Rotation = NumberRange.new(0, 360),
		RotSpeed = NumberRange.new(-8, 8),
		LightEmission = 0,
		Brightness = 1,
		Color = WHITE,
		ZOffset = z,
		LockedToPart = true,
	})
end
local eyeTurn = 0
local function eye(
	parent: Instance,
	name: string,
	rate: number,
	size: number,
	z: number,
	props: { [string]: any }?
)
	eyeTurn += 1
	local p = {
		Texture = if eyeTurn % 2 == 0 then TEX.eyeB else TEX.eyeA,
		FlipbookLayout = Enum.ParticleFlipbookLayout.Grid4x4,
		FlipbookMode = Enum.ParticleFlipbookMode.OneShot,
		Rate = rate,
		Lifetime = NumberRange.new(2.4, 3.0),
		Speed = NumberRange.new(0, 0),
		Size = NS({ { 0, size, size * 0.2 }, { 1, size, size * 0.2 } }),
		Rotation = NumberRange.new(-14, 14),
		LightEmission = 0.12,
		Brightness = 1.15,
		Color = WHITE,
		ZOffset = z,
		LockedToPart = true,
	}
	for k, v in props or {} do
		p[k] = v
	end
	return emitter(parent, name, p)
end

-- CLOAK
do
	local source = SS:FindFirstChild("AuraSources")
	source = source and source:FindFirstChild("TheAlmighty")
	source = source and source:FindFirstChild("Cloak")
	assert(
		source and source:IsA("MeshPart"),
		"ServerStorage.AuraSources.TheAlmighty.Cloak (MeshPart) missing"
	)
	local turn = CFrame.Angles(0, math.rad(CLOAK_YAW), 0)
	local rootCf = CFrame.new(CLOAK.centre) * turn
	local cloak = source:Clone()
	cloak.Name = "Cloak"
	cloak.Size = CLOAK.size
	cloak.TextureID = TEX.cloak
	cloak.Color = Color3.new(1, 1, 1)
	cloak.Material = Enum.Material.SmoothPlastic
	cloak.Reflectance = 0
	cloak.Transparency = 0
	cloak.Anchored = true
	cloak.CanCollide = false
	cloak.CanQuery = false
	cloak.CanTouch = false
	cloak.Massless = true
	cloak.CastShadow = false
	cloak.CFrame = rootCf
	cloak:SetAttribute("RootCF", rootCf)
	for _, c in cloak:GetChildren() do
		c:Destroy()
	end
	cloak.Parent = group("HumanoidRootPart")
	local function onCloak(p: Vector3): CFrame
		-- a root-space point -> the cloak part's own space (the part sits at the mesh's bounding-box centre)
		return turn:Inverse() * CFrame.new(p - CLOAK.centre)
	end
	-- eyes opening ON the cloth
	for i, e in CLOAK.eyes do
		local a = att(cloak, "Eye" .. i, onCloak(e.p), false)
		eye(a, "CloakEye", 0.32, e.size, 0.22)
	end
	-- strands hanging off the torn hem, swaying; every third one drips into the pool
	for i, h in CLOAK.hem do
		local a = att(cloak, "Hem" .. i, onCloak(h.p - Vector3.new(0, 0.22, 0)), false)
		emitter(a, "HemStrands", {
			Texture = TEX.strand,
			FlipbookLayout = Enum.ParticleFlipbookLayout.Grid4x4,
			FlipbookMode = Enum.ParticleFlipbookMode.Loop,
			FlipbookFramerate = NumberRange.new(7, 11),
			FlipbookStartRandom = true,
			Rate = 0.55,
			Lifetime = NumberRange.new(1.8, 2.2),
			Speed = NumberRange.new(0, 0),
			Size = NS({ { 0, 0.34, 0.04 }, { 1, 0.36, 0.04 } }),
			Transparency = NS({ { 0, 1 }, { 0.15, 0.05 }, { 0.8, 0.05 }, { 1, 1 } }),
			Rotation = NumberRange.new(-6, 6),
			LightEmission = 0,
			Brightness = 1,
			Color = WHITE,
			ZOffset = 0.05,
			LockedToPart = true,
		})
		if i % 3 == 0 then
			emitter(a, "HemDrips", {
				Texture = TEX.ink,
				FlipbookLayout = Enum.ParticleFlipbookLayout.Grid4x4,
				FlipbookMode = Enum.ParticleFlipbookMode.OneShot,
				Rate = 0.35,
				Lifetime = NumberRange.new(0.45, 0.6),
				Speed = NumberRange.new(0, 0.2),
				EmissionDirection = Enum.NormalId.Bottom,
				Acceleration = Vector3.new(0, -9, 0),
				Size = NS({ { 0, 0.06 }, { 1, 0.08 } }),
				Transparency = NS({ { 0, 0 }, { 0.85, 0 }, { 1, 1 } }),
				Rotation = NumberRange.new(0, 360),
				LightEmission = 0,
				Brightness = 1,
				Color = WHITE,
			})
		end
	end
end

