--!strict
-- Motion - every authored animation clip, played by NAME, never by id.
--
-- Where a clip comes from, first that exists:
--   1. its uploaded id in Config.Animations (generated by tools/gen_anim_ids.py)
--   2. the KeyframeSequence ReplicatedStorage.Assets.Anims.<Name>, registered
--      once per session with KeyframeSequenceProvider (Studio play-testing
--      before the upload; a live server cannot play these)
--   3. nothing: Motion returns nil and the caller keeps its fallback
--
-- Cosmetics never break gameplay: every entry point is pcall-isolated and a
-- missing clip, rig or Animator is silent. Tracks are cached per Animator, so
-- playing the same clip again never loads a new track.

local KeyframeSequenceProvider = game:GetService("KeyframeSequenceProvider")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Animations = require(ReplicatedStorage.Shared.Config.Animations)

export type Opts = {
	fade: number?,
	speed: number?,
	weight: number?,
	--- Overrides the clip's own Looped.
	looped: boolean?,
	--- Overrides the clip's own priority ("Core", "Action", ...).
	priority: string?,
}

local Motion = {}

local PRIORITY: { [string]: Enum.AnimationPriority } = {
	Core = Enum.AnimationPriority.Core,
	Idle = Enum.AnimationPriority.Idle,
	Movement = Enum.AnimationPriority.Movement,
	Action = Enum.AnimationPriority.Action,
	Action2 = Enum.AnimationPriority.Action2,
	Action3 = Enum.AnimationPriority.Action3,
	Action4 = Enum.AnimationPriority.Action4,
}

-- name -> the content id registered this session ("" = tried, nothing there)
local registered: { [string]: string } = {}
-- content id -> Animation instance (one per id for the whole session)
local animations: { [string]: Animation } = {}
-- Animator -> content id -> its track
local tracks: { [Animator]: { [string]: AnimationTrack } } = setmetatable({}, { __mode = "k" }) :: any

-- The content id for clip `name`, or nil if there is none this session.
local function contentId(name: string): string?
	local clip = Animations.Clips[name]
	if clip and clip.id ~= "" then
		return clip.id
	end
	local cached = registered[name]
	if cached then
		return if cached ~= "" then cached else nil
	end
	local id = ""
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	local anims = assets and assets:FindFirstChild("Anims")
	local sequence = anims and anims:FindFirstChild(name)
	if sequence and sequence:IsA("KeyframeSequence") then
		local ok, result = pcall(function()
			return KeyframeSequenceProvider:RegisterKeyframeSequence(sequence)
		end)
		if ok and typeof(result) == "string" then
			id = result
		end
	end
	-- an absent sequence is looked for again later (the place may still be
	-- streaming it in); a sequence that would not register is not retried
	if id ~= "" or sequence then
		registered[name] = id
	end
	return if id ~= "" then id else nil
end

local function animatorOf(rig: Instance?): Animator?
	if not rig then
		return nil
	end
	if rig:IsA("Animator") then
		return rig
	end
	local controller = if rig:IsA("Humanoid") or rig:IsA("AnimationController")
		then rig
		else rig:FindFirstChildOfClass("Humanoid") or rig:FindFirstChildOfClass(
			"AnimationController"
		)
	if not controller then
		return nil
	end
	local animator = controller:FindFirstChildOfClass("Animator")
	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = controller
	end
	return animator
end

local function trackFor(animator: Animator, id: string): AnimationTrack
	local byId = tracks[animator]
	if not byId then
		byId = {}
		tracks[animator] = byId
	end
	local track = byId[id]
	if track then
		return track
	end
	local animation = animations[id]
	if not animation then
		animation = Instance.new("Animation")
		animation.AnimationId = id
		animations[id] = animation
	end
	local loaded = animator:LoadAnimation(animation)
	byId[id] = loaded
	return loaded
end

--- True when clip `name` can play this session (uploaded or registered).
function Motion.has(name: string): boolean
	local ok, id = pcall(contentId, name)
	return ok and id ~= nil
end

--- The track for clip `name` on `rig` (a Humanoid, AnimationController,
--- Animator or the model holding one), with the clip's priority and looping
--- applied. Nil when the clip or the rig is not there.
--- Fetch these clips' assets now, in the background (a clip's first play otherwise waits for the
--- download: found in play, the reveal's pick-up started 1.2 s late and the throw wind-up lagged).
function Motion.preload(names: { string })
	task.spawn(function()
		local list: { Instance } = {}
		for _, name in names do
			local clip = Animations.Clips[name]
			if clip and clip.id ~= "" then
				local animation = Instance.new("Animation")
				animation.AnimationId = clip.id
				table.insert(list, animation)
			end
		end
		pcall(function()
			game:GetService("ContentProvider"):PreloadAsync(list)
		end)
	end)
end

function Motion.load(rig: Instance?, name: string): AnimationTrack?
	local ok, result = pcall(function(): AnimationTrack?
		local id = contentId(name)
		local animator = animatorOf(rig)
		if not id or not animator then
			return nil
		end
		local track = trackFor(animator, id)
		local clip = Animations.Clips[name]
		if clip then
			track.Priority = PRIORITY[clip.priority] or Enum.AnimationPriority.Action
			track.Looped = clip.looped
		end
		return track
	end)
	if not ok then
		warn(`[Motion] {name} failed inert: {result}`)
		return nil
	end
	return result
end

--- The track for a raw content id (Roblox-owned emotes and defaults).
function Motion.loadId(rig: Instance?, id: string): AnimationTrack?
	local ok, result = pcall(function(): AnimationTrack?
		local animator = animatorOf(rig)
		return if animator and id ~= "" then trackFor(animator, id) else nil
	end)
	return if ok then result else nil
end

local function start(track: AnimationTrack?, opts: Opts?): AnimationTrack?
	if not track then
		return nil
	end
	local ok = pcall(function()
		local o: Opts = opts or {}
		if o.looped ~= nil then
			track.Looped = o.looped
		end
		if o.priority and PRIORITY[o.priority] then
			track.Priority = PRIORITY[o.priority]
		end
		track:Play(o.fade or 0.15, o.weight or 1, o.speed or 1)
	end)
	return if ok then track else nil
end

--- Play clip `name` on `rig`. Returns the playing track, or nil.
function Motion.play(rig: Instance?, name: string, opts: Opts?): AnimationTrack?
	return start(Motion.load(rig, name), opts)
end

--- Play a raw content id on `rig` (priority Action unless opts say).
function Motion.playId(rig: Instance?, id: string, opts: Opts?): AnimationTrack?
	local track = Motion.loadId(rig, id)
	if track and not (opts and opts.priority) then
		pcall(function()
			track.Priority = Enum.AnimationPriority.Action
		end)
	end
	return start(track, opts)
end

--- Stop a track (nil is fine).
function Motion.stop(track: AnimationTrack?, fade: number?)
	if track then
		pcall(function()
			track:Stop(fade or 0.15)
		end)
	end
end

--- Run `fn` each time `track` reaches the keyframe marker `marker`. Returns
--- the connection (disconnect it when the moment is over), or nil.
function Motion.onMarker(track: AnimationTrack?, marker: string, fn: () -> ()): RBXScriptConnection?
	if not track then
		return nil
	end
	local ok, connection = pcall(function()
		return track:GetMarkerReachedSignal(marker):Connect(function()
			local fine, err = pcall(fn)
			if not fine then
				warn(`[Motion] marker {marker} handler failed inert: {err}`)
			end
		end)
	end)
	return if ok then connection else nil
end

--- The Roblox-owned emote ids (Config.Animations.Emotes).
function Motion.emotes(): { string }
	return Animations.Emotes
end

return Motion
