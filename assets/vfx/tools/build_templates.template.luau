--!nocheck
-- build_templates.luau: GENERATED by assets/vfx/tools/pack_all.py from assets/vfx/effects/*.json.
-- Do not edit by hand; rebuild with `python assets/vfx/tools/pack_all.py`.
--
-- EDIT MODE (command bar / execute_luau). Builds every effect template into
-- ReplicatedStorage.Assets.Vfx.<Name> (replacing an existing one), yield-free, and RETURNS a
-- report string: built count, PROP_FAILS, textures without an id.
--
-- Texture ids: assets/vfx/ids.json ({"textures": {"<file>": id}, "meshes": {}}) is embedded at
-- pack time. To override without re-packing, run `_G.VFX_IDS = {textures = {...}}` first.
-- To build only some effects: `_G.VFX_ONLY = {"Reveal_Epic", "Coin_Pop"}` first.
--
-- Each template: a Folder with attributes Loop, Attach ("point"|"part"|"root"), Screen, Duration,
-- NoTint, MissingAssets; a StringValue "Timeline" (JSON, read by src/client/Fx/VfxKit.luau); and the
-- effect's carrier Parts (CFrames RELATIVE to the effect origin), each instance tagged with a
-- "SimPath" attribute the timeline addresses.

local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

--@@IDS@@
local EFFECTS = {}
--@@EFFECTS@@

local ids = _G.VFX_IDS or HttpService:JSONDecode(IDS_JSON)
local texIds = ids.textures or {}
local PROP_FAILS = {}
local missing = {}

local function texUri(key)
	local id = texIds[key]
	if id == nil or id == "" then
		missing[key] = true
		return nil
	end
	id = tostring(id)
	if id:match("^%d+$") then
		return "rbxassetid://" .. id
	end
	return id
end

-- Roblox requires a sequence to start at time 0 and end at exactly 1. Authored lists can stop
-- short (a colour that holds after 0.6) or land at 0.9999999 after rounding: clamp, sort, and
-- extend the first and last values to the ends.
local function span(list)
	local out = {}
	for _, k in list do
		local copy = table.clone(k)
		copy[1] = math.clamp(copy[1], 0, 1)
		table.insert(out, copy)
	end
	table.sort(out, function(a, b)
		return a[1] < b[1]
	end)
	if #out == 0 then
		return out
	end
	if out[1][1] > 1e-4 then
		local first = table.clone(out[1])
		first[1] = 0
		table.insert(out, 1, first)
	else
		out[1][1] = 0
	end
	if out[#out][1] < 1 - 1e-4 then
		local last = table.clone(out[#out])
		last[1] = 1
		table.insert(out, last)
	else
		out[#out][1] = 1
	end
	return out
end

local function nseq(list)
	local keys = {}
	for _, k in span(list) do
		local env = k[3] or 0
		table.insert(keys, NumberSequenceKeypoint.new(k[1], k[2], math.min(env, k[2])))
	end
	return NumberSequence.new(keys)
end

local function cseq(list)
	local keys = {}
	for _, k in span(list) do
		table.insert(keys, ColorSequenceKeypoint.new(k[1], Color3.new(k[2], k[3], k[4])))
	end
	return ColorSequence.new(keys)
end

local function decode(v)
	if type(v) ~= "table" then
		return v
	end
	if v.NR then
		return NumberRange.new(v.NR[1], v.NR[2])
	elseif v.NS then
		return nseq(v.NS)
	elseif v.CS then
		return cseq(v.CS)
	elseif v.C3 then
		return Color3.new(v.C3[1], v.C3[2], v.C3[3])
	elseif v.V3 then
		return Vector3.new(v.V3[1], v.V3[2], v.V3[3])
	elseif v.V2 then
		return Vector2.new(v.V2[1], v.V2[2])
	elseif v.E then
		local a, b = string.match(v.E, "^([%w]+)%.([%w]+)$")
		return Enum[a][b]
	elseif v.T then
		return texUri(v.T) or ""
	end
	return nil
end

local function cfOf(cf)
	return CFrame.new(cf[1], cf[2], cf[3])
		* CFrame.Angles(math.rad(cf[4] or 0), math.rad(cf[5] or 0), math.rad(cf[6] or 0))
end

local function soft(inst, prop, value)
	local ok = pcall(function()
		inst[prop] = value
	end)
	if not ok then
		PROP_FAILS[inst.ClassName .. "." .. prop] = true
	end
end

local function buildOne(name, data)
	local folder = Instance.new("Folder")
	folder.Name = name
	local byPath, refs = {}, {}
	local missBefore = 0
	for _ in missing do
		missBefore += 1
	end
	local function node(n, parent, prefix)
		local path = if prefix == "" then n.n else prefix .. "." .. n.n
		local inst = Instance.new(n.c)
		inst.Name = n.n
		inst:SetAttribute("SimPath", path)
		if n.c == "Part" then
			inst.Anchored = true
			inst.CanCollide = false
			inst.CanQuery = false
			inst.CanTouch = false
			inst.CastShadow = false
			inst.Transparency = 1
			inst.Size = if n.sz then Vector3.new(n.sz[1], n.sz[2], n.sz[3]) else Vector3.new(1, 1, 1)
			inst.CFrame = cfOf(n.cf or { 0, 0, 0 })
		elseif n.c == "Attachment" then
			inst.CFrame = cfOf(n.cf or { 0, 0, 0 })
		end
		for k, v in n.a or {} do
			inst:SetAttribute(k, v)
		end
		for k, v in n.p or {} do
			if type(v) == "table" and v.Ref then
				table.insert(refs, { inst, k, v.Ref })
			else
				local d = decode(v)
				if d ~= nil then
					soft(inst, k, d)
				end
			end
		end
		byPath[path] = inst
		inst.Parent = parent
		for _, c in n.k or {} do
			node(c, inst, path)
		end
	end
	for _, n in data.inst do
		node(n, folder, "")
	end
	for _, r in refs do
		local target = byPath[r[3]]
		if target then
			soft(r[1], r[2], target)
		else
			PROP_FAILS["Ref " .. r[3]] = true
		end
	end
	-- timeline: resolve texture refs (overlay images) to asset ids, keep the rest encoded
	for _, e in data.tl do
		if type(e.image) == "table" and e.image.T then
			e.image = texUri(e.image.T) or ""
		end
	end
	local tl = Instance.new("StringValue")
	tl.Name = "Timeline"
	tl.Value = HttpService:JSONEncode(data.tl)
	tl.Parent = folder
	local m = data.meta
	folder:SetAttribute("Loop", m.loop)
	folder:SetAttribute("Attach", m.attach)
	folder:SetAttribute("Screen", m.screen)
	folder:SetAttribute("Duration", m.duration)
	folder:SetAttribute("NoTint", m.notint)
	local missAfter = 0
	for _ in missing do
		missAfter += 1
	end
	-- count this effect's own missing textures
	local own = 0
	for _, d in folder:GetDescendants() do
		for _, prop in { "Texture" } do
			local ok, v = pcall(function()
				return d[prop]
			end)
			if ok and v == "" then
				own += 1
			end
		end
	end
	folder:SetAttribute("MissingAssets", own)
	return folder, missAfter - missBefore
end

local assets = ReplicatedStorage:FindFirstChild("Assets")
if not assets then
	assets = Instance.new("Folder")
	assets.Name = "Assets"
	assets.Parent = ReplicatedStorage
end
local vfx = assets:FindFirstChild("Vfx")
if not vfx then
	vfx = Instance.new("Folder")
	vfx.Name = "Vfx"
	vfx.Parent = assets
end

local only = nil
if type(_G.VFX_ONLY) == "table" then
	only = {}
	for _, n in _G.VFX_ONLY do
		only[n] = true
	end
end

local names = {}
for name in EFFECTS do
	if not only or only[name] then
		table.insert(names, name)
	end
end
table.sort(names)

local built, failed, incomplete = {}, {}, {}
for _, name in names do
	local ok, err = pcall(function()
		local data = HttpService:JSONDecode(EFFECTS[name])
		local folder = buildOne(name, data)
		local old = vfx:FindFirstChild(name)
		if old then
			old:Destroy()
		end
		folder.Parent = vfx
		if (folder:GetAttribute("MissingAssets") or 0) > 0 then
			table.insert(incomplete, name)
		end
	end)
	if ok then
		table.insert(built, name)
	else
		table.insert(failed, name .. ": " .. tostring(err))
	end
end

local fails, miss = {}, {}
for k in PROP_FAILS do
	table.insert(fails, k)
end
for k in missing do
	table.insert(miss, k)
end
table.sort(fails)
table.sort(miss)
return string.format(
	"built %d/%d into ReplicatedStorage.Assets.Vfx | FAILED: %s | PROP_FAILS: %s | "
		.. "textures without id (%d): %s | templates with missing assets (VfxKit skips them): %s",
	#built,
	#names,
	if #failed > 0 then table.concat(failed, "; ") else "none",
	if #fails > 0 then table.concat(fails, ", ") else "none",
	#miss,
	if #miss > 0 then table.concat(miss, ", ", 1, math.min(#miss, 12)) .. (if #miss > 12 then " ..." else "") else "none",
	if #incomplete > 0 then table.concat(incomplete, ", ") else "none"
)
